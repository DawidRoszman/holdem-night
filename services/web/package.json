{
  "name": "web-client",
  "version": "1.0.0",
  "description": "Texas Hold'em browser client (static; Tailwind CSS + three.js table)",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i src/styles.css -o public/style.css --minify",
    "build:js": "esbuild src/table3d.js src/profile-charts.js --bundle --format=esm --minify --target=es2022 --outdir=public",
    "watch:css": "tailwindcss -i src/styles.css -o public/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@tanstack/charts": "^0.18.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "three": "^0.186.1"
  }
}
